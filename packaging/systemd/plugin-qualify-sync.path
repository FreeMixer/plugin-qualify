# SPDX-License-Identifier: GPL-3.0-or-later
# A plugin installed into one of these directories is qualified soon after: the service waits for a minute of
# quiet first. The standard folders are named here; the folders qualify.conf adds (lv2_path, lv2_extra, clap_path,
# clap_extra) are written into a drop-in by plugin-qualify-sync-generator at boot and at every daemon-reload.
[Unit]
Description=Qualify plugins as they are installed
Documentation=man:plugin-qualify-sync(1)

[Path]
PathChanged=/usr/lib/lv2
PathChanged=/usr/lib64/lv2
PathChanged=/usr/local/lib/lv2
PathChanged=/usr/lib/clap
PathChanged=/usr/lib64/clap
Unit=plugin-qualify-sync.service

[Install]
WantedBy=paths.target
