# SPDX-License-Identifier: GPL-3.0-or-later
# The quick qualification of every plugin added or changed since the last run (plugin-qualify-sync(1)).
# Started by plugin-qualify-sync.timer a little after boot and by plugin-qualify-sync.path when a plugin
# directory changes; no boot target waits for it.
[Unit]
Description=Qualify the plugins added or changed since the last run
Documentation=man:plugin-qualify-sync(1)
After=local-fs.target

[Service]
Type=oneshot
# a package install writes many files: the run starts once the plugin directories have been quiet for a minute.
# The interpreter is named first: when systemd executes the node script itself, Fedora's SELinux policy keeps the
# service in systemd's own domain (init_t), which may neither make V8's code pages executable nor write under /tmp,
# and the run dies before its first line; executing /usr/bin/node takes the ordinary daemon transition.
ExecStart=/usr/bin/node /usr/bin/plugin-qualify-sync --system --no-wait --settle-s 60
# Its temporary files (the sync's world, the scan's and the probes' directories, all taken from os.tmpdir()) go
# under /run/omx/plugin-qualify-sync, which systemd creates, labels and removes when the run ends: /tmp is the first
# thing a hardened unit loses (#192). Its own subdirectory, so the removal never takes another unit's /run/omx.
RuntimeDirectory=omx/plugin-qualify-sync
Environment=TMPDIR=%t/omx/plugin-qualify-sync
# /var/lib/omx and the descriptors in it are read by the console, another user (#221)
StateDirectory=omx omx/qualify-home
StateDirectoryMode=0755
# A plugin reads and writes under its HOME, and a system unit has none: without it Surge XT is silent under jalv and the
# adapter and its CLAP answers -503, and the sync would judge the plugin by that. One of its own, on disk, so the first run
# of a plugin fills no real user's home and no memory under /run.
Environment=HOME=%S/omx/qualify-home
UMask=0022
# The audio comes first, and the machine stays reachable: the lowest CPU priority and the disk only when nothing else
# wants it; at most two cores' worth of CPU (on a four-core machine two stay free, so sshd and the console answer
# during a sweep); a memory ceiling the plugins' processes share (one past it is killed and recorded as crashed, the
# run goes on); a cap on processes and threads; and no real-time scheduling, which a plugin under test must not
# take from the audio. The Raspberry Pi 4 figures (1000M, 64 tasks) are the ones a sweep was held to by hand there.
Nice=19
CPUQuota=200%
IOSchedulingClass=idle
MemoryMax=1000M
TasksMax=64
RestrictRealtime=yes
# RuntimeMaxSec= has no effect on a oneshot service, whose run is its start: the start is what is bounded. A run
# cut short keeps every plugin it finished, and the next one goes on from there.
TimeoutStartSec=6h
