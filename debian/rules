#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# the CLAP prober, the LV2 measurer and their interposer; the headers come from clap-headers,
# plugin-hostd-dev, liblilv-dev and lv2-dev, the LV2 host features from libomx-clap-lv2-dev
override_dh_auto_build:
	$(MAKE) -C native

# policy keeps a package's private programs in /usr/lib/<package>
override_dh_auto_install:
	packaging/build.sh $(CURDIR)/debian/plugin-qualify /usr/lib
	$(MAKE) -C native install DESTDIR=$(CURDIR)/debian/plugin-qualify LIBEXECDIR=/usr/lib/plugin-qualify
	install -D -m 0755 packaging/trigger-scan.sh $(CURDIR)/debian/plugin-qualify/usr/lib/plugin-qualify/trigger-scan
	install -D -m 0644 packaging/systemd/80-plugin-qualify.preset $(CURDIR)/debian/plugin-qualify/usr/lib/systemd/system-preset/80-plugin-qualify.preset

# the units are handed to dh_installsystemd as its own files, so it installs them where this release's systemd
# reads them (/lib/systemd/system on bookworm, /usr/lib/systemd/system on trixie). The timer and the path unit are
# enabled and none is started here, so no sweep runs inside the package transaction; postinst arms the path unit,
# which runs nothing until a plugin directory changes. The timer's first run is at the next boot.
SYNC_UNITS = service timer path

execute_before_dh_installsystemd:
	for u in $(SYNC_UNITS); do cp packaging/systemd/plugin-qualify-sync.$$u debian/plugin-qualify.plugin-qualify-sync.$$u; done

override_dh_installsystemd:
	dh_installsystemd --name=plugin-qualify-sync --no-start --no-stop-on-upgrade

# python3-lilv writes the LV2 descriptors. Debian 12 (bookworm) does not carry it, so a package built there must stay
# installable: the dependency is filled in for any other release, read from /etc/os-release (the build container has it,
# and no apt index or network is needed).
LILV_DEPENDS := $(shell . /etc/os-release && if [ "$$VERSION_ID" = 12 ]; then :; else echo python3-lilv; fi)

override_dh_gencontrol:
	dh_gencontrol -- -Vlilv:Depends="$(LILV_DEPENDS)"

override_dh_auto_clean:
	$(MAKE) -C native clean
	rm -f $(foreach u,$(SYNC_UNITS),debian/plugin-qualify.plugin-qualify-sync.$(u))

override_dh_auto_test:
