@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix work: <http://lv2plug.in/ns/ext/worker#> .

# Measuring-host fixtures (2026-09-25-plugin-qualify.md §2a): each plugin
# refuses to work unless the host is faithful in ONE way, and says so in the audio it produces.

<urn:plugin-qualify:fixture:needs-options> a lv2:Plugin , lv2:UtilityPlugin ;
  doap:name "needs options (JUCE-like)" ;
  lv2:requiredFeature urid:map , opts:options , bufsz:boundedBlockLength ;
  lv2:port [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ] ,
           [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ] .

<urn:plugin-qualify:fixture:worker-engine> a lv2:Plugin , lv2:UtilityPlugin ;
  doap:name "worker builds its engine (Hex Chain-like)" ;
  lv2:requiredFeature urid:map , work:schedule ;
  lv2:extensionData work:interface ;
  lv2:port [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ] ,
           [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ] .

<urn:plugin-qualify:fixture:patch-gain#gain> a lv2:Parameter ; rdfs:label "gain" ; rdfs:range atom:Float ;
  lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:default 0.5 .

<urn:plugin-qualify:fixture:patch-gain> a lv2:Plugin , lv2:UtilityPlugin ;
  doap:name "patch-only parameter (JUCE 8-like)" ;
  lv2:requiredFeature urid:map ;
  patch:writable <urn:plugin-qualify:fixture:patch-gain#gain> ;
  lv2:port [ a lv2:InputPort , atom:AtomPort ; atom:bufferType atom:Sequence ;
             atom:supports patch:Message ; lv2:designation lv2:control ;
             lv2:index 0 ; lv2:symbol "control" ; lv2:name "Control" ] ,
           [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in" ; lv2:name "In" ] ,
           [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out" ] .

<urn:plugin-qualify:fixture:wide-gain> a lv2:Plugin , lv2:AmplifierPlugin ;
  doap:name "linear gain 1/64x .. 64x (Calf-like)" ;
  lv2:requiredFeature urid:map ;
  lv2:port [ a lv2:InputPort , lv2:ControlPort ; lv2:index 0 ; lv2:symbol "gain" ; lv2:name "Gain" ;
             lv2:default 1.0 ; lv2:minimum 0.015625 ; lv2:maximum 64.0 ] ,
           [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in" ; lv2:name "In" ] ,
           [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out" ] .

<urn:plugin-qualify:fixture:banner> a lv2:Plugin , lv2:UtilityPlugin ;
  doap:name "prints to stdout while instantiating (Guitarix-like)" ;
  lv2:requiredFeature urid:map ;
  lv2:port [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ] ,
           [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ] .
